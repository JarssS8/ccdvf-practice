{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ccdvf-practice",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth needs AsyncLocalStorage
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "exam.jarsss8.es", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ccdvf-practice", "database_id": "2fba57e6-0a0f-4e70-bcb3-7ad659e88985", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["17 4 * * *"] },
  "vars": {
    "BETTER_AUTH_URL": "https://exam.jarsss8.es",
    "DEEPSEEK_MODEL": "deepseek-flash",
    "DEEPSEEK_CHECK_MODEL": "deepseek-v4-pro",
    "AI_USER_DAILY_LIMIT": "15",
    "AI_GLOBAL_DAILY_LIMIT": "400"
  }
  // Secrets (wrangler secret put): BETTER_AUTH_SECRET, DEEPSEEK_API_KEY,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET (each provider is enabled only when both are set)
}
