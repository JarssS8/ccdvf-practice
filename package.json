{
  "name": "ccdvf-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "predeploy": "git diff --quiet -- src/content || (echo 'src/content has uncommitted changes: review and commit them before deploying' >&2; exit 1)",
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "tsc -b && tsc -p worker && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "node scripts/test-local.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "db:migrate": "wrangler d1 migrations apply ccdvf-practice --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "better-auth": "1.7.14",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright-core": "1.56.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "5.0.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
